{
  "name": "@moscow/api",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "wrangler deploy --dry-run --outdir=.wrangler-build",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply moscow-city-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply moscow-city-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.142.0"
  }
}
